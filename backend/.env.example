PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskoraq
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
# NODE_ENV=production   # in production JWT_SECRET (32+ chars) is mandatory and demo data is not seeded
# SEED_DEMO=true        # only if you really want the demo users (password: password123) in production
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# TRUST_PROXY=true       # set when running behind a reverse proxy so rate limits use the real client IP

# Optional: real invite emails (without these the invite link is printed in this server's console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM="Taskoraq <you@gmail.com>"

# Admin setup. Public sign-up always creates Viewers. Create the first admin with ONE of:
#   a) npm run create-admin   (ADMIN_EMAIL=... ADMIN_PASSWORD=... in the shell, run on the server)
#   b) set ADMIN_SETUP_SECRET below (16+ chars), then POST /api/auth/setup-admin once; remove the secret afterwards
# ADMIN_SETUP_SECRET=
# UPLOAD_DIR=/var/data/taskoraq-uploads   # optional: where attachments are stored (default backend/uploads)
